<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:text="Aviator Behaviour AI" android:textSize="24sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/status" android:text="Ready — start UltraScan to monitor the screen." android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/start" android:text="START ULTRASCAN" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/stop" android:text="STOP" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/events" android:text="Visual events are recorded while monitoring." android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>